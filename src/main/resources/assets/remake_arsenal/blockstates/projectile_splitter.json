    {
      "when": {
        "special": "east"
      },
      "apply": {
        "model": "remake_arsenal:block/splitter_port_special",
        "y": 90
      }
    },
    {
      "when": {
        "special": "south"
      },
      "apply": {
        "model": "remake_arsenal:block/splitter_port_special",
        "y": 180
      }
    },
    {
      "when": {
        "special": "west"
      },
      "apply": {
        "model": "remake_arsenal:block/splitter_port_special",
        "y": 270
      }
    },
    {
      "when": {
        "special": "up"
      },
      "apply": {
        "model": "remake_arsenal:block/splitter_port_special",
        "x": 270
      }
    },
    {
      "when": {
